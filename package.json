{
  "name": "celengin",
  "productName": "Celengin",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm:client\"",
    "server": "node --watch server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && node electron/launch.cjs",
    "app:icon": "node electron/make-icon.cjs",
    "app:shortcut": "node electron/make-shortcut.cjs",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "imapflow": "^2.0.6"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.4.5": true
  },
  "main": "electron/main.js",
  "description": "Aplikasi keuangan pribadi dengan penyimpanan lokal.",
  "build": {
    "appId": "com.celengin.desktop",
    "productName": "Celengin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/icon.png",
      "electron/tray.png",
      "server.js",
      "package.json",
      "!**/*.db",
      "!**/*.db-*",
      "!**/.env*",
      "!backups/**",
      "!AI-PROMPT-SPEC.md",
      "!node_modules/better-sqlite3/{deps,src,build,docs}/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/!(win32-x64.node)"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "id"
    ],
    "compression": "maximum",
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Celengin-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "npmRebuild": false
  }
}
